@* {Id:int} takes the number from the URL: /posts/3 -> Id = 3 *@
@page "/posts/{Id:int}"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject IPostService PostService
@inject ICommentService CommentService
@inject IUserService UserService

@if (error != null)
{
    <p style="color:red">@error</p>
}

@if (post == null)
{
    <p>Loading...</p>
}
else
{
    <h3>@post.Title</h3>
    <p>by @post.AuthorUserName</p>
    <p>@post.Body</p>

    <h4>Comments</h4>
    @if (post.Comments == null || post.Comments.Count == 0)
    {
        <p>No comments yet.</p>
    }
    else
    {
        <ul>
            @foreach (var c in post.Comments)
            {
                <li>@NameOf(c.UserId): @c.Body</li>
            }
        </ul>
    }

    <h4>Add comment</h4>
    @* No "who are you?" dropdown any more: the comment is written as the logged-in user *@
    <input placeholder="Comment" @bind="commentBody" @bind:event="oninput" />
    <button @onclick="AddComment">Add</button>
}

<p><a href="posts">Back to all posts</a></p>

@code {
    // Filled in by the framework, because Routes.razor wraps the app in CascadingAuthenticationState
    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = null!;

    // Filled in automatically from the route
    [Parameter] public int Id { get; set; }

    private PostDto? post;
    private List<UserDto> users = new();
    private string commentBody = "";
    private int currentUserId; // the logged-in user, read from the "Id" claim
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Who is logged in? Read the "Id" claim that SimpleAuthProvider stored
            AuthenticationState authState = await State;
            ClaimsPrincipal user = authState.User;
            if (user.Identity is not null && user.Identity.IsAuthenticated)
            {
                currentUserId = int.Parse(user.Claims.Single(c => c.Type == "Id").Value);
            }

            users = (await UserService.GetManyUsersAsync()).ToList(); // still needed to show author names
            await LoadPost();
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }

    private async Task LoadPost()
    {
        // true = also ask the API for this post's comments
        post = await PostService.GetSinglePostAsync(Id, true);
    }

    // The comment only has a UserId, so look the name up in the users list
    private string NameOf(int userId)
    {
        return users.FirstOrDefault(u => u.Id == userId)?.UserName ?? $"user {userId}";
    }

    private async Task AddComment()
    {
        try
        {
            error = null;
            await CommentService.CreateCommentAsync(new CreateCommentDto
            {
                Body = commentBody,
                UserId = currentUserId, // the logged-in user, no dropdown needed
                PostId = Id             // the post we are looking at
            });
            commentBody = "";
            await LoadPost(); // reload so the new comment shows up
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }
}