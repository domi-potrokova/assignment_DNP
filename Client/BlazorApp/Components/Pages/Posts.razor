@*author dropdown went away bc the logged in user is the author, only the owner sees the delete button*@

@page "/posts"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject IPostService PostService

<h3>Posts</h3>

<h4>Create post</h4>
<input placeholder="Title" @bind="title" @bind:event="oninput" />
<input placeholder="Body" @bind="body" @bind:event="oninput" />
<button @onclick="CreatePost">Create</button>

@if (error != null)
{
    <p style="color:red">@error</p>
}

<h4>All posts</h4>
@if (posts == null)
{
    <p>Loading...</p>
}
else
{
    <ul>
        @foreach (var post in posts)
        {
            <li>
                <a href="posts/@post.Id">[@post.Id] @post.Title</a>
                @* Only the author of the post gets a Delete button *@
                @if (post.UserId == currentUserId)
                {
                    <button @onclick="() => DeletePost(post.Id)">Delete</button>
                }
            </li>
        }
    </ul>
}

@code {
    // The framework fills this in because Routes.razor wraps the app in CascadingAuthenticationState
    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = null!;

    private IEnumerable<PostDto>? posts;
    private string title = "";
    private string body = "";
    private int currentUserId;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Who is logged in? Read the "Id" claim that SimpleAuthProvider stored
            AuthenticationState authState = await State;
            ClaimsPrincipal user = authState.User;
            if (user.Identity is not null && user.Identity.IsAuthenticated)
            {
                currentUserId = int.Parse(user.Claims.Single(c => c.Type == "Id").Value);
            }

            await LoadPosts();
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }

    private async Task LoadPosts()
    {
        posts = await PostService.GetManyPostsAsync();
    }

    private async Task CreatePost()
    {
        try
        {
            error = null;
            await PostService.CreatePostAsync(new CreatePostDto
            {
                Title = title,
                Body = body,
                UserId = currentUserId // the logged-in user is the author, no dropdown needed
            });
            title = "";
            body = "";
            await LoadPosts();
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }

    private async Task DeletePost(int id)
    {
        try
        {
            error = null;
            await PostService.DeletePostAsync(id);
            await LoadPosts();
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }
}
