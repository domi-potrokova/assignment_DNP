@page "/users"
@* Needed in .NET 8+ Blazor Web Apps, otherwise buttons do nothing *@
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject IUserService UserService

<h3>Users</h3>

<h4>Create user</h4>
<input placeholder="Username" @bind="newUserName" @bind:event="oninput" />
<input type="password" placeholder="Password" @bind="newPassword" @bind:event="oninput" />
<button @onclick="CreateUser">Create</button>

@if (error != null)
{
    <p style="color:red">@error</p>
}

<h4>All users</h4>
@if (users == null)
{
    <p>Loading...</p>
}
else
{
    <ul>
        @foreach (var user in users)
        {
            <li>
                [@user.Id] @user.UserName
                @* Only show Delete next to the logged-in user's own entry *@
                @if (user.Id == currentUserId)
                {
                    <button @onclick="() => DeleteUser(user.Id)">Delete</button>
                }
            </li>
        }
    </ul>
}

@code {
    // Filled in by the framework, because Routes.razor wraps the app in CascadingAuthenticationState
    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = null!;

    private IEnumerable<UserDto>? users;
    private string newUserName = "";
    private string newPassword = "";
    private int currentUserId; // the logged-in user, read from the "Id" claim
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        // Who is logged in? Read the "Id" claim that SimpleAuthProvider stored
        AuthenticationState authState = await State;
        ClaimsPrincipal user = authState.User;
        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            currentUserId = int.Parse(user.Claims.Single(c => c.Type == "Id").Value);
        }

        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            users = await UserService.GetManyUsersAsync();
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }

    private async Task CreateUser()
    {
        try
        {
            error = null;
            await UserService.CreateUserAsync(new CreateUserDto
            {
                UserName = newUserName,
                Password = newPassword
            });
            newUserName = "";
            newPassword = "";
            await LoadUsers();
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }

    private async Task DeleteUser(int id)
    {
        try
        {
            error = null;
            await UserService.DeleteUserAsync(id);
            await LoadUsers();
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }
}